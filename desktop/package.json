{
  "name": "coverao-escritorio",
  "version": "1.0.9",
  "private": true,
  "description": "AO 2027 para escritorio. El cliente de cada servidor se verifica con la firma del autor.",
  "main": "main.js",
  "desktopName": "coverao.desktop",
  "scripts": {
    "start": "electron .",
    "windows": "electron-builder --win",
    "linux": "electron-builder --linux",
    "mac": "electron-builder --mac",
    "test": "node test-firma.js && node test-actualizacion.js",
    "firmar": "node firmar.js",
    "armar": "node armar.js"
  },
  "build": {
    "appId": "ar.coverao.escritorio",
    "productName": "AO 2027",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "firma.js",
      "actualizacion.js",
      "compilacion.json",
      "clave-publica.pem",
      "menu.html",
      "menu/**",
      "build/icon.png"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "CoverAO",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AO 2027",
      "artifactName": "CoverAO-Setup.${ext}",
      "deleteAppDataOnUninstall": true,
      "include": "build/instalador.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "CoverAO-x86_64.${ext}",
      "executableName": "coverao",
      "synopsis": "AO 2027 — Argentum Online",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "fast-uri@^3": "3.1.9",
    "minimatch@^9 || ^10": "11.0.5",
    "undici@^6": "6.29.1",
    "undici@^7": "7.30.2"
  }
}
