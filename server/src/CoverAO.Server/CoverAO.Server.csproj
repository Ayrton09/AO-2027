<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CoverAO.Protocol\CoverAO.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI del panel de administración (servida por AdminServer desde AppContext.BaseDirectory/wwwroot). -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoverAO.Protocol.Tests" />
    <InternalsVisibleTo Include="CoverAO.Postgres.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las versiones del esquema de la base (Data/AlmacenRelacional.cs las aplica al abrir, las de cada motor). Van ADENTRO del ejecutable: un
         esquema que viaja aparte se puede quedar atrás del servidor que lo usa. -->
    <EmbeddedResource Include="Data\Esquema\*.sql" LogicalName="Esquema/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
