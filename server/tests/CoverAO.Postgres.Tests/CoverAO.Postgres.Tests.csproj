<Project Sdk="Microsoft.NET.Sdk">

  <!-- LAS PRUEBAS CONTRA POSTGRES (fase5/postgres/DISENO.md, sección 9). Aparte del proyecto de siempre y FUERA de la
       solución, para que un `dotnet test` casual no pida Postgres: las corre la puerta (verificar.ps1), que lo prende. Sin
       Postgres FALLAN, no se saltean. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- xunit v3 pide pasar el token de cancelación del test a cada espera; acá las esperas son cortas. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoverAO.Server\CoverAO.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- La batería de contrato es UNA para todos los almacenes: el archivo se comparte, no se copia. -->
    <Compile Include="..\CoverAO.Protocol.Tests\ContratoDelAlmacenTests.cs" Link="ContratoDelAlmacenTests.cs" />
  </ItemGroup>

</Project>
