<Project>
  <!-- Versión de todos los proyectos .NET del server. Debe coincidir con /VERSION en la raíz
       y Build.Version al publicar un release. El ingreso exige esa misma versión. -->
  <PropertyGroup>
    <Version>1.0.42</Version>
    <AssemblyVersion>1.0.42.0</AssemblyVersion>
    <FileVersion>1.0.42.0</FileVersion>
  </PropertyGroup>
</Project>
