<Project>
  <!-- Versión de todos los proyectos .NET del server. Debe coincidir con /VERSION en la raíz
       y Build.Version al publicar un release. Es independiente de la versión del protocolo de ingreso. -->
  <PropertyGroup>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
  </PropertyGroup>
</Project>
