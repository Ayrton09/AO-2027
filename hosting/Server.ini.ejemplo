; ============================================================================
;  CoverAO - Server.ini
;
;  TODAS las claves tienen un valor por defecto sensato: el servidor arranca
;  sin este archivo. Lo que pongas aca PISA el valor por defecto.
;  Los valores de abajo SON los valores por defecto.
;
;  Que hace cada una, con el detalle: HOSTING.md, tabla "Opciones del Server.ini".
; ============================================================================

[INIT]

; --- Red ---------------------------------------------------------------------
; De StartPort salen los otros tres: +1 WebSocket, +2 panel de admin, +3 web.
; Con varios servidores en la misma maquina, separalos de a 10 (7666, 7676...).
StartPort=7666
; 0 = el cliente web deduce el puerto solo. Ponelo si hay un proxy adelante.
PuertoWebSocketPublico=0
; Pagina publica en el puerto web (1) o solo el juego (0).
PaginaPublica=1
; Origenes que puede tener el navegador, separados por coma. Vacio = cualquiera.
OrigenesPermitidos=

; --- Cupos y limites ---------------------------------------------------------
; 0 = sin tope, en todos los que dicen 0.
MaxUsers=0
AllowMultiLogins=1
LimiteConexionesPorIp=0
IdleLimit=0
MaxPaquetesPorSegundo=150
RafagaDePaquetes=200

; --- Seguridad y anticheat ---------------------------------------------------
; Trampas detectadas que hacen falta para echar y para banear. 0 = ese escalon
; apagado. Las trampas se cuentan en la CUENTA y sobreviven al relog.
TrampasParaEchar=3
TrampasParaBanear=6
; Personajes de una misma IP jugando a la vez, y cuentas nuevas que esa IP
; puede crear cada diez minutos. 0 = sin tope.
MaxPersonajesPorIp=10
CuentasNuevasPorIp=3
; Largo minimo de una contrasena. NO aplica al codigo de recuperacion, que en
; el original es un PIN de hasta cuatro numeros.
ClaveMinima=6
; Movimientos de oro de este monto o mas van a data\logs\economia-*.log.
EconomiaUmbralOro=1000

; --- Cadencia de lo que se dice ----------------------------------------------
MsEntreMensajes=700
RafagaDeMensajes=5
MsEntreConsultas=300
RafagaDeConsultas=10

; --- Reglas de la casa -------------------------------------------------------
PuedeCrearPersonajes=1
ServerSoloGMs=0
; Cuantas veces la experiencia y el oro que da cada criatura: 1 = normal,
; 5 = cinco veces, 100 = cien veces. El server original venia con 200.
Exp=1
Oro=1
; El evento de experiencia del GM (/EXP, el panel) y el bonus de donador van en lo que
; se cobra golpe a golpe; lo que queda al matar a la criatura va sin ellos, y el hechizo
; que mata cobra todo ahi. 1 = el evento tambien va en lo que queda. 0 = como el original.
EventoAlRematar=0
; Cuanto oro entra en cada monton que se tira al piso (1 a 32767). Tirar mas se reparte
; en varios montones alrededor. El original: 10000.
OroPorMonton=10000
; Al tocar Lanzar, el cliente web marca hasta donde llega el hechizo (1) o no (0).
AlcanceDelHechizo=1
; Cada portal dice a donde lleva: un cartel arriba y el texto al clickearlo (1) o no (0).
DestinoDeLosPortales=1
; Si llueve tambien bajo techo y en las cuevas (1, como el original) o no (0).
LluviaBajoTecho=0
; Desde cuanta vida maxima una criatura hostil es un JEFE y muestra su vida en una barra
; arriba de la pantalla (0 = sin barra). Con 50000 son los dragones grandes, los golems, etc.
VidaMinimaDeJefe=50000
; A quien le vende el mercader, segun la zona. Facciones: Renegado, Ciudadano, Republicano,
; Caos, Armada, Milicia (separadas por coma; vacio = a nadie). Los valores de abajo son los
; del original: Rinkel es Rinkel, Nueva Esperanza y el Dungeon de Newbies; las ciudades viejas,
; Ullathorpe, Nix, Banderbill, Arghal; el resto, el campo y los mapas sueltos.
ComercioEnRinkel=Renegado, Ciudadano, Republicano, Caos, Armada, Milicia
ComercioEnLindos=Ciudadano, Republicano, Armada, Milicia
ComercioEnCiudadesViejas=
ComercioEnElResto=
; Minutos que dura un dia completo y cada cambio de clima, y cuanto llueve.
MinutosDelDia=24
MinutosDeClima=18
PorcentajeLluvia=18
OroAlSubirNivel=0
; Al morir donde se cae el inventario, el que lleva este oro o menos encima lo pierde todo al piso (con mas, nada).
; 0 = no se cae nunca, como el original de 2021.
OroQueSeCaeAlMorir=100000
; La vida de nivel 1. original = 15 + de 1 a Constitucion/3 al azar (el AO de siempre); fija = 20 para todos;
; constitucion = 15 + Constitucion/3, sin azar; clase = 10 + la vida que gana su clase al subir de nivel.
VidaInicial=original
CuraAlSubirNivel=1
QuitarEquipoNovato=1
; Que lo tirado al piso sobreviva al reinicio.
PersistirSuelo=1
; Minutos que dura prendida una fogata antes de apagarse sola. En el original NO se apaga
; nunca (la rutina que las juntaba para borrarlas quedo declarada y sin escribir), asi que
; el default del servidor es 0 = como el original. 0 apaga la regla.
MinutosDeFogata=5
; Dos reglas del original que vienen APAGADAS: el centinela antimacro y que el
; familiar busque enemigos solo.
Centinela=0
FamiliarBusca=0

; --- Balance del golpe paralizante -------------------------------------------
; Vueltas de 40 ms que dura, y el dado (1 entre N) contra criatura y jugador. Los 295 de la criatura son las 30
; vueltas del original medidas en su reloj de criaturas, que corre cada 380 ms.
GolpeParalizanteVueltas=295
GolpeParalizanteVueltasPvP=150
GolpeParalizanteDado=500
GolpeParalizanteDadoGladiadorBardo=300

; --- Mundo -------------------------------------------------------------------
PasesDeRinkel=0
HipocamposEnMarAbierto=1
; Puntos de Navegacion que piden los pasajes que cruzan el agua a otra tierra
; (entre puertos del mismo continente no piden nada). En el original no piden
; nada: 0 = como el original.
NavegacionParaCruzar=80
; 1 entre N criaturas deja el drop global. 0 = apagado.
DropGlobal=10000
; Metamorfosis del druida: -1 = permanente (como el AO clasico), 0 = apagada, o los segundos que dura.
MetamorfosisDelDruida=-1

; Atacar a un ciudadano o a un soldado (sin guerra de clanes ni faccion enemiga)
; te vuelve criminal y te echa del ejercito. 0 = atacar no cambia el estado.
AtacarAliadoVuelveCriminal=1

; --- Guardias de las ciudades ------------------------------------------------
; En el original NO atacan (su IA esta apagada): 0 = como el original.
GuardiasAtacan=1
; 1 = persiguen al que ven hasta que se va de la ciudad, y vuelven a su puesto.
; 0 = quietos: pegan al que pasa al lado y los que saben magia tiran al que ven.
GuardiasPersiguen=1
; 0 = a los newbies (hasta nivel 15) no los tocan aunque sean del otro bando.
GuardiasAtacanNewbies=0
; A quien ataca cada bando. Facciones: Renegado, Ciudadano, Republicano, Caos,
; Armada y Milicia. Vacio = ese bando no ataca a nadie.
GuardiasImperialesAtacanA=Renegado, Republicano, Caos, Milicia
GuardiasRepublicanosAtacanA=Renegado, Ciudadano, Caos, Armada
GuardiasDelCaosAtacanA=Renegado, Ciudadano, Republicano, Armada, Milicia

; --- Bots --------------------------------------------------------------------
; Personajes que juegan solos, para que el mundo no se vea vacio. VIENEN
; APAGADOS: 0 = ninguno, y el maximo son 96 (los nombres que hay para repartir).
; Cada bot entra por el mismo login que un jugador: ocupa un lugar de MaxUsers,
; sale en el /ONLINE y en la pagina publica, y no puede hacer nada que un
; jugador no pueda. Cazan, huyen de lo que les queda grande, levantan el botin,
; toman pociones, comen, meditan, comercian, suben de nivel y se desconectan
; cada tanto para volver mas tarde. Lo unico que no hacen es hablar.
; Sus cuentas llevan el sufijo _bot y quedan anotadas en data\bots.txt, para
; que puedas distinguirlos de la gente de verdad.
; Esa contrasena no sirve desde afuera: la cuenta de un bot solo se abre
; desde adentro del servidor.
Bots=0

; --- Operacion ---------------------------------------------------------------
; Estos vienen PRENDIDOS aunque borres el archivo: hay que escribir 0 para
; apagarlos, no para tenerlos.
MinutosGuardarUsuarios=15
MinutosBackup=30
BackupsAConservar=48
LogDias=7

; --- Staff -------------------------------------------------------------------
; Cuantos hay de cada rango. Los NOMBRES DE PERSONAJE van en las secciones de
; mas abajo, numerados desde 1.
;
; OJO: con todo en 0 el servidor abre SIN NINGUN GM. Nadie puede contestar un
; /GM, echar a un tramposo, ni ver los avisos del anticheat desde adentro.
Admines=0
Dioses=0
SemiDioses=0
Consejeros=0
RolesMasters=0

; --- Publicacion -------------------------------------------------------------
; Donde esta el codigo, para el aviso de licencia del cliente.
CodigoFuente=https://github.com/Ayrton09/CoverAO
; Version que se le exige al cliente. VACIO = entra cualquiera, y se queda asi:
; el control es una comparacion literal, y prenderlo con un numero que no sea
; EXACTO al del cliente que repartiste deja a todos afuera.
Version=

; --- Los nombres del staff ---------------------------------------------------
; Ejemplo, para un Dios llamado Rugura:  Dioses=1  arriba, y aca  Dios1=Rugura
[Admines]
;Admin1=

[Dioses]
;Dios1=

[SemiDioses]
;SemiDios1=

[Consejeros]
;Consejero1=

[RolesMasters]
;RM1=

; --- Cadencias de combate, en milisegundos -----------------------------------
; Son las del servidor original y estos son los valores que usa si la seccion
; no esta. Tocarlas cambia el BALANCE y lo aleja del original.
; Fuera de 0..60000 se recorta.
;
; IntervaloHechizoUsar es NUESTRO: el original deja tomar la pocion en el mismo
; instante que sale el hechizo, y de eso vive el auto-pot. Contra el auto-pot,
; poner ese y IntervaloGolpeUsar en 2000 o 3000.
; ---------------------------------------------------------------------------
; NIVEL MINIMO PARA ENTRAR A CADA CUEVA  (regla de la casa; el original NO la tiene)
;
; El original trae un campo `Restringir` por mapa, lo carga y deja que un GM lo
; edite, pero nadie lo lee para negar la entrada. Esta seccion si: el que pisa la
; salida hacia uno de estos mapas sin el nivel queda donde estaba, con un aviso.
; Los GM entran siempre.
;
; SIN ESTA SECCION la regla no corre y el server se comporta como el original.
; Una linea por MAPA porque una cueva son varios: el Dungeon Cristal son tres.
; Los numeros son los que paso el tester; el autor decidio SOLO minimo, sin tope.
; ---------------------------------------------------------------------------
[NIVELMINIMO]
; Cueva orca
753=20
; Caverna del Pirata
117=30
; Dungeon Cristal (el tester: subir el minimo a 40)
230=40
; Dungeon Cristal
231=40
; Dungeon Cristal
232=40
; Dungeon Dragon. El tester dijo 35 o 40; aoweb lo tiene en 30 y se copia ese,
; por decision del autor. Nuestra data lo respalda: pega menos que el Veriil
; (golpe 350 contra 480) aunque de mas experiencia.
48=30
; Dungeon Veriil
140=28
; Dungeon Veriil
141=28
; Dungeon Veriil
142=28
; Dungeon Veriil
143=28
; Dungeon Veriil
144=28
; Dungeon Veriil
145=28
; Fuerte Veriil -- es el septimo mapa del Veriil y colgaba sin minimo. Tiene la
; misma dureza que el resto (Golem de piedra, golpe 480) y se sale de el al 142.
; aoweb lo gatea como parte del dungeon, con el mismo numero.
146=28
; Dungeon Gaugin (el tester: subir de 20 a 30)
207=30
; Dungeon Marabel (el tester: redondear a 20)
115=20
; Dungeon Marabel
116=20
; Dungeon Zero
209=35
; Dungeon Zero
210=35
; Dungeon Zero
211=35
; Minas Dorck
50=25
; Minas Dorck
51=25
; Minas Dorck
52=25
; Mina Kirle
233=38
; Minas Thyr
33=20
;
; --- Las dos que faltaban de la tabla del tester -----------------------------
; DE DONDE SALEN ESTOS NUMEROS. Los del tester, de su informe. Tres dungeons los
; tiene tambien aoweb (github.com/dcatanzaro/aoweb), que gatea 24 mapas con un
; `minLevel` propio, y por decision del autor ESOS TRES se copian tal cual de ahi:
;   Dungeon Marabel 20 (los dos dan igual) | Dungeon Veriil 28 | Dungeon Dragon 30
; El cruce va POR NOMBRE, no por numero de mapa: la numeracion no coincide entre
; los dos juegos (su mapa 33 es 'Minas de Hierro' y el nuestro Minas Thyr).
; El resto de la tabla no existe en aoweb, asi que queda como lo puso el tester o,
; para el Forzhe y las Minas Thordore, calibrado contra su propia escala.
;
; 'minas veril' YA ESTA: se le pregunto a la data y en todo el juego hay solo DOS
; mapas con yacimiento de oro, y uno es el 145, que es parte del Dungeon Veriil
; (140-145) y ya quedo en 30 -- el mismo numero que el pidio.
;
; 'minas de oro' es el otro: el 754, el subsuelo del Dungeon Forzhe, con 34 vetas.
; Es el yacimiento mas rico con oro del juego.
;
; PERO AL 754 SE ENTRA SOLO POR EL 755, asi que el minimo que manda de verdad para
; llegar al oro es el de ese piso (30), no el del subsuelo. Para bajarlo a 25 habria
; que bajar tambien el 755 -- y el 755 tiene Medusas de golpe 250, que es exactamente
; la Caverna del Pirata, que el tester puso en 30.
;
; Y ya que el Forzhe se abria, van sus cinco mapas con la rampa que tienen adentro,
; cada uno por lo que vive ahi. Se entra desde el 650 (Latifundio Abandonado) por
; tres puertas distintas -- al 755, al 756 y al 757 -- asi que gatear uno solo dejaba
; las otras dos abiertas.

; Dungeon Forzhe (Subsuelo) -- EL ORO, 34 vetas. Saqueador de minas, golpe 180
754=25
; Dungeon Forzhe (1er Piso) -- por aca se baja al oro. Medusa, golpe 250
755=30
; Dungeon Forzhe (2do Piso) -- Castigador, golpe 250
757=30
; Dungeon Forzhe (Entre Piso) -- Golem infernal, golpe 530
756=35
; Dungeon Forzhe (2do Piso) -- Dragon Legendario: 1.750.000 de experiencia, CUATRO
; veces el Gran Dragon Negro del Dungeon Zero. Es lo mas gordo de toda la tabla.
760=40
; Minas Thordore -- 32 vetas de plata y hierro. Golem de oro, golpe 510
205=35
;
; NO SE LE PONE MINIMO al 747 (Fuerte Central) aunque sea el mapa con MAS yacimientos
; del juego (69): no tiene una sola criatura hostil. Un minimo ahi no protegeria a
; nadie de nada, solo le cerraria a los mineros el mejor lugar seguro para picar.

; ============================ CUANTO TARDAN EN VOLVER LOS BICHOS ============================
; REGLA DE LA CASA, como [NIVELMINIMO]: el original NO tiene ninguna clave de esto. Alla la criatura
; reaparece AL INSTANTE -- `MuereNpc` llama a `ReSpawnNpc` justo despues de tirar el oro, sin ninguna
; espera-- y su campo `RespawnTime` del NPCs.dat es data muerta: una linea suelta lo pisa para todos.
; El otro AO que miramos (github.com/dcatanzaro/aoweb) hace lo mismo: cero espera para todo, salvo los
; dragones, que esperan una hora.
;
; Aca hay TRES escalones segun lo que valga la criatura, porque una rata y el Dragon Legendario no
; pueden volver a la misma velocidad. El corte lo marca nuestra data: de las 124 hostiles la mediana da
; 3.200 de experiencia, y despues del cuarto puesto cae 2,3 veces de golpe.
;
;   3.900.000  El Abominable Grinch      |  550.000  Guardian
;   2.200.000  Rey Dragon                |  450.000  Gran Dragon Negro
;   1.750.000  Dragon Legendario         |  ... 16 mas por encima de 100.000
;   1.250.000  Gran Hechicero Garveloth  |
;   --- cae x2,3 ---                     |    3.200  la mediana
;
; Los valores son los de abajo; descomentar para cambiarlos. 0 = vuelve en el acto, como el original.
[RESPAWN]
;Segundos=30          ; el comun: casi todas las criaturas
;SegundosGordo=300    ; 5 min, los que dan mucha experiencia
;SegundosJefe=1800    ; 30 min, los cuatro jefes del mundo
;ExpGordo=100000      ; desde que experiencia cuenta como gordo
;ExpJefe=1000000      ; desde que experiencia cuenta como jefe

[INTERVALOS]
;IntervaloLanzaHechizo=1000       ; entre un hechizo y el siguiente
;IntervaloUserPuedeAtacar=1000    ; entre un golpe y el siguiente
;IntervaloMagiaGolpe=400          ; pegar despues de castear
;IntervaloGolpeMagia=400          ; castear despues de pegar
;IntervaloGolpeUsar=400           ; usar un objeto despues de pegar
;IntervaloHechizoUsar=0           ; usar un objeto despues de castear
;IntervaloFlechasCazadores=1100   ; entre un disparo de arco y el siguiente
;IntervaloParalizado=500          ; cada cuanto se reintenta el paralizado
;IntervaloCerrarConexion=5        ; segundos que queda en un mapa inseguro al salir o cortarse
;IntervaloGuardarUsuarios=15      ; el del original; equivale a MinutosGuardarUsuarios

[BASEDEDATOS]
; Donde se guardan los personajes y las cuentas. sqlite = un archivo, data/coverao.db, nada que instalar;
; postgres = un servidor con paginas web que leen la misma base (ver docs/HOSTING.md). Sin Tipo, sqlite. Si ya
; habia personajes en archivos (.chr y .cnt), el primer arranque los importa y deja lo viejo renombrado a
; *.importado. Con postgres y la base vacia, importa igual la coverao.db de data/: asi se pasa de SQLite a Postgres.
;Tipo=sqlite
;Archivo=coverao.db
; Con postgres: donde esta la base. La clave, mejor desde el entorno (COVERAO_BASEDEDATOS_CLAVE).
;Servidor=localhost
;Puerto=5432
;Base=coverao
;Usuario=coverao
;Clave=
